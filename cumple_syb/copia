    <script>
        // --- LOGIC: Evasive and Dynamic "No" Button ---
        const btnNo = document.getElementById('btn-no');
        const noPhrases = [
            "¿Segura, mi amor? 🥺",
            "¡Pénsalo bien! 🌸",
            "¡Error 404: Opción no válida! ❌",
            "¡Sabía que querías decir Sí! ❤️"
        ];
        let noCount = 0;

        function evadeOrTransformNo() {
            if (noCount < noPhrases.length - 1) {
                btnNo.innerText = noPhrases[noCount];
                noCount++;
                // Slight shrink effect to favor YES
                btnNo.style.transform = `scale(${1 - (noCount * 0.08)})`;
            } else {
                // Morph completely into YES
                btnNo.innerText = noPhrases[noPhrases.length - 1];
                btnNo.className = "w-full sm:w-auto px-8 py-3.5 bg-gradient-to-r from-pink-400 to-rose-400 text-white font-semibold rounded-full shadow-lg hover:scale-105 transition duration-300";
                btnNo.onclick = unlockSurprise;
            }
        }

        // --- LOGIC: Unlock Page & Confetti Effect ---
        function unlockSurprise() {
            // Trigger Confetti
            launchConfetti();

            // Play background music
            const audio = document.getElementById('bg-music');
            if (audio) {
                audio.play().catch(e => console.log("Audio autoplay restricted:", e));
            }

            // Smooth transition
            const hero = document.getElementById('hero-section');
            const mainContent = document.getElementById('main-content');

            hero.style.opacity = '0';
            setTimeout(() => {
                hero.classList.add('hidden');
                mainContent.classList.remove('hidden');
                setTimeout(() => {
                    mainContent.classList.remove('opacity-0');
                    document.getElementById('counter-section').scrollIntoView({ behavior: 'smooth' });
                }, 50);
            }, 700);
        }

        // --- LOGIC: Canvas Confetti Effect ---
        function launchConfetti() {
            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const particles = [];
            const colors = ['#FAD0C9', '#B76E79', '#FFFDF9', '#F48FB1', '#FFD54F'];

            for (let i = 0; i < 120; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height - canvas.height,
                    size: Math.random() * 8 + 4,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    speedY: Math.random() * 3 + 2,
                    speedX: Math.random() * 2 - 1,
                    rotation: Math.random() * 360
                });
            }

            function render() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                particles.forEach(p => {
                    p.y += p.speedY;
                    p.x += p.speedX;
                    p.rotation += 2;
                    ctx.save();
                    ctx.translate(p.x, p.y);
                    ctx.rotate((p.rotation * Math.PI) / 180);
                    ctx.fillStyle = p.color;
                    ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
                    ctx.restore();
                });

                if (particles.some(p => p.y < canvas.height)) {
                    requestAnimationFrame(render);
                } else {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                }
            }
            render();
        }

        // --- LOGIC: Audio Controls ---
        let isPlaying = true;
        function toggleAudio() {
            const audio = document.getElementById('bg-music');
            const icon = document.getElementById('music-icon');
            if (isPlaying) {
                audio.pause();
                icon.className = "fas fa-play text-sm";
            } else {
                audio.play();
                icon.className = "fas fa-music text-sm animate-pulse";
            }
            isPlaying = !isPlaying;
        }

        // --- LOGIC: Time Counter (05-Julio-2024) ---
        const startDate = new Date('2024-07-05T00:00:00').getTime();

        setInterval(() => {
            const now = new Date().getTime();
            const diff = now - startDate;

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            document.getElementById('time-counter').innerHTML = `
                <div class="glass-card p-4 rounded-2xl"><span class="text-3xl font-bold text-pink-600 font-playfair">${days}</span><p class="text-xs text-gray-500 uppercase tracking-wider mt-1">Días</p></div>
                <div class="glass-card p-4 rounded-2xl"><span class="text-3xl font-bold text-pink-600 font-playfair">${hours}</span><p class="text-xs text-gray-500 uppercase tracking-wider mt-1">Horas</p></div>
                <div class="glass-card p-4 rounded-2xl"><span class="text-3xl font-bold text-pink-600 font-playfair">${minutes}</span><p class="text-xs text-gray-500 uppercase tracking-wider mt-1">Minutos</p></div>
                <div class="glass-card p-4 rounded-2xl"><span class="text-3xl font-bold text-pink-600 font-playfair">${seconds}</span><p class="text-xs text-gray-500 uppercase tracking-wider mt-1">Segundos</p></div>
            `;
        }, 1000);

        // --- LOGIC: Toggle 3D Envelope ---
        function toggleEnvelope() {
            const envelope = document.querySelector('.envelope-container');
            envelope.classList.toggle('open');
        }

        // --- LOGIC: Random Poem / Compliment Generator ---
        const poems = [
            "Eres la coincidencia más bonita que me ha regalado la vida.",
            "Tus 21 años son solo el comienzo de una historia hermosa que quiero escribir a tu lado.",
            "Si las flores tuvieran envidia, seguro le envidiarían a tu sonrisa su dulzura.",
            "Contigo cada día se siente como un domingo tranquilo lleno de paz y abrazos.",
            "Eres el lugar al que siempre quiero regresar. Feliz cumpleaños, Sybelle.",
            "No necesito buscar magia en otros lados, me basta con mirarte a los ojos."
        ];

        function generatePoem() {
            const display = document.getElementById('poem-display');
            display.style.opacity = '0';
            setTimeout(() => {
                const randomPoem = poems[Math.floor(Math.random() * poems.length)];
                display.innerText = `"${randomPoem}"`;
                display.style.transition = 'opacity 0.5s ease';
                display.style.opacity = '1';
            }, 300);
        }

        // --- LOGIC: Date Builder Step Navigation ---
        const dateSelections = { comida: '', outfit: '', hora: '', postre: '' };

        function selectDateOption(category, value, currentStep) {
            dateSelections[category] = value;
            
            // Highlight selected card visually
            const currentContainer = document.getElementById(`date-step-${currentStep}`);
            const cards = currentContainer.querySelectorAll('.option-card');
            cards.forEach(c => c.classList.remove('selected'));
            event.currentTarget.classList.add('selected');

            // Move to next step smoothly
            setTimeout(() => {
                currentContainer.classList.add('hidden');
                const nextStepContainer = document.getElementById(`date-step-${currentStep + 1}`);
                if (nextStepContainer) {
                    nextStepContainer.classList.remove('hidden');
                    
                    // Update Step Indicator
                    const nextInd = document.getElementById(`step-ind-${currentStep + 1}`);
                    if (nextInd) {
                        nextInd.className = "w-10 h-10 rounded-full bg-pink-500 text-white font-bold flex items-center justify-center shadow-md";
                    }
                }
            }, 400);
        }

        function finishDateBuilder(postreValue) {
            dateSelections.postre = postreValue;
            
            // Hide quiz step 4
            document.getElementById('date-step-4').classList.add('hidden');

            // Show Ticket Section
            const ticketSection = document.getElementById('vip-ticket-section');
            ticketSection.classList.remove('hidden');

            // Inject values
            document.getElementById('res-comida').innerText = dateSelections.comida;
            document.getElementById('res-outfit').innerText = dateSelections.outfit;
            document.getElementById('res-hora').innerText = dateSelections.hora;
            document.getElementById('res-postre').innerText = dateSelections.postre;

            // Scroll to ticket
            ticketSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        // --- LOGIC: Export Ticket as Image (html2canvas) ---
        function downloadTicketImage() {
            const ticketElement = document.getElementById('ticket-render');
            html2canvas(ticketElement, {
                scale: 2,
                backgroundColor: null
            }).then(canvas => {
                const link = document.createElement('a');
                link.download = 'Pase_VIP_Cumple_Sybelle.png';
                link.href = canvas.toDataURL('image/png');
                link.click();
            });
        }

        // --- LOGIC: Send Ticket via WhatsApp ---
        function sendToWhatsApp() {
            <!-- 📱 REEMPLAZA ESTE NÚMERO CON TU TELÉFONO REAL CON CÓDIGO DE PAÍS (Ej: 521234567890 para México) -->
            const myPhoneNumber = "523313656746";

            const message = `¡Hola mi amor! Ya armé mi cita perfecta de cumpleaños para mis 21:%0A%0A`
                + `🍽️ *Comida:* ${dateSelections.comida}%0A`
                + `👗 *Outfit:* ${dateSelections.outfit}%0A`
                + `⏰ *Hora:* ${dateSelections.hora}%0A`
                + `🍰 *Postre:* ${dateSelections.postre}%0A%0A`
                + `¡Estoy lista para celebrar juntos! Te amo ❤️`;

            window.open(`https://api.whatsapp.com/send?phone=${myPhoneNumber}&text=${message}`, '_blank');
        }
    </script>
