                <div class="mt-6 pt-4 border-t border-dashed border-pink-300 text-xs text-gray-500">
                    Válido para celebrar a la novia más bonita el 28 de Septiembre
                </div>
            </div>

            <!-- Action Export Buttons -->
            <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
                <button onclick="downloadTicketImage()" 
                        class="px-6 py-3.5 bg-gray-800 text-white font-semibold rounded-full shadow-lg hover:bg-gray-900 transition flex items-center justify-center gap-2 text-sm">
                    <i class="fas fa-download"></i> Descargar Pase VIP (PNG)
                </button>
                
                <button onclick="sendToWhatsApp()" 
                        class="px-6 py-3.5 bg-emerald-500 text-white font-semibold rounded-full shadow-lg hover:bg-emerald-600 transition flex items-center justify-center gap-2 text-sm">
                    <i class="fab fa-whatsapp text-lg"></i> Enviármelo por WhatsApp
                </button>
