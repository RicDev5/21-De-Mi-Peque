    <style>
        :root {
            --pastel-pink: #FAD0C9;
            --soft-pink: #FCE4EC;
            --rose-gold: #B76E79;
            --deep-rose: #9C525D;
            --cream-white: #FFFDF9;
            --text-main: #4A3B3C;
            --glass-bg: rgba(255, 255, 255, 0.65);
            --glass-border: rgba(255, 255, 255, 0.85);
        }

        body {
            font-family: 'Poppins', sans-serif;
            color: var(--text-main);
            background: linear-gradient(135deg, #FFF5F6 0%, #FAD0C9 50%, #FCE4EC 100%);
            min-height: 100vh;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        .font-playfair { font-family: 'Playfair Display', serif; }
        .font-dancing { font-family: 'Dancing Script', cursive; }

        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            box-shadow: 0 12px 40px rgba(183, 110, 121, 0.18);
            border-radius: 24px;
        }

        .glass-button {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 4px 15px rgba(183, 110, 121, 0.15);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(183, 110, 121, 0.25);
        }

        /* Floating Animation */
        .floating-sticker {
            position: absolute;
            animation: floatSticker 6s ease-in-out infinite;
            z-index: 5;
            pointer-events: none;
            filter: drop-shadow(0 6px 12px rgba(183, 110, 121, 0.2));
        }

        @keyframes floatSticker {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-18px) rotate(6deg); }
        }

        .envelope-container {
            perspective: 1000px;
            width: 100%;
            max-width: 520px;
            height: 320px;
            margin: 0 auto;
            position: relative;
            cursor: pointer;
        }

        .envelope {
            width: 100%;
            height: 100%;
            position: absolute;
            background: #FFE8EC;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(183, 110, 121, 0.25);
            transform-style: preserve-3d;
            transition: transform 0.8s ease;
            border: 2px solid rgba(255, 255, 255, 0.8);
        }

        .envelope-flap {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 55%;
            background: #F8D1D8;
            clip-path: polygon(0 0, 50% 100%, 100% 0);
            transform-origin: top;
            transition: transform 0.8s 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 4;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
        }

        .envelope-container.open .envelope-flap {
            transform: rotateX(180deg);
            z-index: 1;
        }

        .letter {
            position: absolute;
            top: 10px;
            left: 5%;
            width: 90%;
            height: 92%;
            background: #FFFDF9;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            transition: transform 0.8s 0.4s cubic-bezier(0.4, 0, 0.2, 1), z-index 0.4s;
            z-index: 3;
            padding: 24px;
            overflow-y: auto;
            border: 1px solid #FAD0C9;
        }

        .envelope-container.open .letter {
            transform: translateY(-160px);
            height: 440px;
            z-index: 10;
        }

        .polaroid-card {
            background: #FFFFFF;
            padding: 14px 14px 28px 14px;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(183, 110, 121, 0.15);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform-style: preserve-3d;
        }

        .polaroid-card:hover {
            transform: translateY(-10px) rotate(2deg) scale(1.03);
            box-shadow: 0 20px 40px rgba(183, 110, 121, 0.3);
        }

        /* Option Cards in Date Builder */
        .option-card {
            border: 2px solid transparent;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .option-card:hover {
            transform: translateY(-5px);
            border-color: var(--rose-gold);
            box-shadow: 0 10px 25px rgba(183, 110, 121, 0.2);
        }

        .option-card.selected {
            border-color: var(--deep-rose);
            background: rgba(255, 255, 255, 0.95);
            box-shadow: 0 0 0 4px rgba(183, 110, 121, 0.2);
        }

        /* VIP Pass Ticket */
        .vip-ticket {
            background: linear-gradient(135deg, #FFFFFF 0%, #FFF0F3 50%, #FCE4EC 100%);
            border: 2px dashed var(--rose-gold);
            border-radius: 20px;
            position: relative;
            box-shadow: 0 20px 50px rgba(183, 110, 121, 0.25);
        }

        /* Canvas Confetti Layer */
        #confetti-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 100;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--soft-pink); }
        ::-webkit-scrollbar-thumb { background: var(--rose-gold); border-radius: 4px; }
    </style>
</head>
