        <!-- SECTION 7: VIP BIRTHDAY TICKET & EXPORT OPTIONS -->
        <section id="vip-ticket-section" class="py-12 px-6 max-w-2xl mx-auto hidden">
            
            <div id="ticket-render" class="vip-ticket p-8 md:p-10 text-center relative overflow-hidden">
                <div class="absolute -right-8 -top-8 w-24 h-24 bg-pink-200/50 rounded-full blur-xl"></div>
                
                <span class="px-3 py-1 bg-pink-500 text-white text-[11px] font-bold rounded-full tracking-wider uppercase inline-block mb-3">
                    VIP PASS • 21st BIRTHDAY
                </span>

                <h2 class="font-playfair text-3xl font-bold text-gray-800 mb-1">Cita de Cumpleaños</h2>
                <p class="font-dancing text-2xl text-pink-600 font-semibold mb-6">Sybelle ❤️</p>

                <div class="space-y-3 text-left bg-white/70 p-5 rounded-xl border border-pink-200 text-sm">
